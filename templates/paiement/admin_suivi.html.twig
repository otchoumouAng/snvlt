{% extends 'template_base.html.twig' %}

{% block Title %}
    {% trans %}SNVLT{% endtrans %} - {% trans %}Suivi des paiements{% endtrans %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/suivi/admin_suivi.js') }}"></script>
{% endblock %}

{% block menu %}
    {% include 'base/menu.html.twig' %}
{% endblock %}

{% block page_content %}
<div class="container-fluid px-4 py-4">
    <div class="card">
        <div class="card-header">
            <h5 class="card-title fw-bold"><i class="ph-fill ph-credit-card"></i> Suivi des paiements</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-3">
                    <label for="filter_avis" class="form-label">Avis de recette</label>
                    <input type="text" id="filter_avis" class="form-control" placeholder="Filtrer par avis">
                </div>
                <div class="col-md-3">
                    <label for="filter_service" class="form-label">Service</label>
                    <input type="text" id="filter_service" class="form-control" placeholder="Filtrer par service">
                </div>
                <div class="col-md-3">
                    <label for="filter_statut" class="form-label">Statut</label>
                    <select id="filter_statut" class="form-select">
                        <option value="">Tous</option>
                        <option value="PAYE">Payé</option>
                        <option value="EN_ATTENTE">En attente</option>
                        <option value="ECHOUE">Echoué</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="filter_societe" class="form-label">Société</label>
                    <input type="text" id="filter_societe" class="form-control" placeholder="Filtrer par société">
                </div>
            </div>
            <div class="table-responsive">
                <table id="datatable_admin_suivi" class="table table-hover table-striped">
                    <thead>
                        <tr>
                            <th><i class="ph ph-file-text"></i> Avis de recette</th>
                            <th><i class="ph ph-wrench"></i> Service</th>
                            <th><i class="ph ph-wallet"></i> Montant payé</th>
                            <th><i class="ph ph-phone"></i> Numéro de paiement</th>
                            <th><i class="ph ph-receipt"></i> Reference Paiement</th>
                            <th><i class="ph ph-calendar"></i> Date de paiement</th>
                            <th><i class="ph ph-info"></i> Statut</th>
                            <th><i class="ph ph-buildings"></i> Société</th>
                            <th class="text-end"><i class="ph ph-list-checks"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in transactions %}
                            {% set transaction = item.transaction %}
                            <tr data-id="{{ transaction.id }}">
                                <td>{{ transaction.identifiant }}</td>
                                <td>{{ transaction.service ? transaction.service.designation : 'N/A' }}</td>
                                <td>{{ transaction.paidAmount ? (transaction.paidAmount | number_format(0, ',', ' ') ~ ' FCFA') : 'N/A' }}</td>
                                <td>{{ transaction.payerPhone }}</td>
                                <td>{{ transaction.tresorpayReceiptReference }}</td>
                                <td>{{ transaction.paidAt ? transaction.paidAt|date('d/m/Y H:i') : 'N/A' }}</td>
                                <td>
                                    <span class="badge
                                        {% if transaction.statut == 'PAYE' %} bg-success-subtle text-success-emphasis
                                        {% elseif transaction.statut == 'EN_ATTENTE' %} bg-warning-subtle text-warning-emphasis
                                        {% else %} bg-danger-subtle text-danger-emphasis {% endif %}">
                                        {{ transaction.statut }}
                                    </span>
                                </td>
                                <td>{{ item.company | default('N/A') }}</td>
                                <td class="text-end">
                                    <a href="{{ path('app_paiement_notice', {'id': transaction.id}) }}" class="btn btn-sm btn-outline-secondary" title="Télécharger l'avis de recette">
                                        <i class="ph ph-download-simple"></i> Avis
                                    </a>
                                    {% if transaction.statut == 'PAYE' %}
                                        <a href="{{ path('app_paiement_receipt', {'id': transaction.id}) }}" class="btn btn-sm btn-primary" title="Télécharger le reçu">
                                            <i class="ph ph-receipt"></i> Reçu
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="9" class="text-center text-muted">Aucune transaction trouvée.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="transactionDetailsModal" tabindex="-1" aria-labelledby="transactionDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="transactionDetailsModalLabel">Détails de la transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="modal-loader" class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                <div id="modal-content-details" style="display: none;">
                    <!-- Details will be injected here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}