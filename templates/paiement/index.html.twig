{% extends 'template_base.html.twig' %}

{% block Title %}
    SNVLT - Nouvelle Transaction de Paiement
{% endblock %}

{% block menu %}
    {% include 'base/menu.html.twig' %}
{% endblock %}

{% block page_content %}

{# Ajout de la feuille de style pour TomSelect #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.bootstrap5.min.css">

<style>
    /* Styles pour le stepper (indicateur d'étapes) */
    .stepper {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 0 auto 3rem auto;
        width: 100%;
        max-width: 600px;
    }
    .stepper::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        transform: translateY(-50%);
        width: 100%;
        height: 2px;
        background-color: #e9ecef; /* Gris clair */
        z-index: 1;
    }
    .stepper .progress-bar {
        position: absolute;
        top: 50%;
        left: 0;
        transform: translateY(-50%);
        height: 2px;
        background-color: #0d6efd; /* Bleu Bootstrap */
        z-index: 2;
        width: 0;
        transition: width 0.4s ease;
    }
    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 3;
        text-align: center;
        width: 120px;
    }
    .step-icon {
        height: 40px;
        width: 40px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 50%;
        background-color: #fff;
        border: 2px solid #e9ecef;
        font-weight: bold;
        transition: all 0.4s ease;
        color: #adb5bd; /* Gris pour le numéro */
    }
    .step-label {
        margin-top: 0.75rem;
        font-size: 0.9rem;
        font-weight: 500;
        color: #6c757d; /* Gris pour le libellé */
        transition: all 0.4s ease;
    }

    /* États du stepper */
    .step.active .step-icon {
        border-color: #0d6efd;
        color: #0d6efd;
    }
    .step.active .step-label {
        color: #0d6efd;
        font-weight: bold;
    }
    .step.completed .step-icon {
        border-color: #198754; /* Vert Bootstrap */
        background-color: #198754;
        color: #fff;
        font-size: 0; /* On cache le numéro */
    }
    .step.completed .step-icon::after {
        content: '✓'; /* On affiche une coche */
        font-size: 20px;
    }
    .step.completed .step-label {
        color: #198754;
    }

    /* Styles pour le contenu des étapes */
    .step-content {
        display: none;
        animation: fadeIn 0.5s;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Styles pour la carte de résumé */
    #summary-card {
        background-color: #f8f9fa;
        border: 1px solid #dee2e6;
        border-radius: .5rem;
        padding: 1.5rem;
        margin-top: 2rem;
        transition: all 0.3s ease-in-out;
    }
    #summary-card h5 {
        color: #0d6efd;
    }
    #summary-card .summary-amount {
        font-size: 1.5rem;
        font-weight: bold;
        color: #198754;
    }
    /* Amélioration visuelle pour TomSelect pour mieux s'intégrer avec Bootstrap */
    .ts-control {
        padding: .5rem .75rem;
        border-radius: .375rem;
        border-color: #ced4da;
    }
</style>

<div class="container-fluid">
    <h2 class="text-dark font-weight-bold mb-4">
        <i class="mdi mdi-cash-register"></i> Initier une Transaction de Paiement
    </h2>

    <div class="card">
        <div class="card-body p-lg-5">

            <!-- Stepper UI -->
            <div class="stepper mb-5">
                <div class="progress-bar" style="width: 0%;"></div>
                <div class="step active" data-step="1">
                    <div class="step-icon">1</div>
                    <div class="step-label">Choix du service</div>
                </div>
                <div class="step" data-step="2">
                    <div class="step-icon">2</div>
                    <div class="step-label">Confirmation</div>
                </div>
                <div class="step" data-step="3">
                    <div class="step-icon">3</div>
                    <div class="step-label">Paiement</div>
                </div>
            </div>

            <!-- Conteneur principal du workflow -->
            <div id="transaction-workflow"
                 data-user-nom="{{ app.user.nomUtilisateur|default('')|e('html_attr') }}"
                 data-user-prenom="{{ app.user.prenomsUtilisateur|default('')|e('html_attr') }}"
                 data-user-telephone="{{ app.user.mobile|default('')|e('html_attr') }}"
                 data-type-demandes-url="{{ path('app_types_demande_data') }}"
                 data-type-paiements-url="{{ path('app_types_paiement_data') }}"
                 data-user-pefs-url="{{ path('app_user_pef_data') }}"
                 data-service-details-url="{{ path('api_service_details') }}"
                 data-submit-url="{{ path('api_create_transaction') }}"
                 data-suivi-url="http://localhost:8001/suivi-mes-paiements"
            >
                <!-- Étape 1: Choix du service (regroupe toutes les sélections) -->
                <div class="step-content" data-step="1" style="display: block;">
                    <h4 class="card-title mb-4">Étape 1: Configurez votre service</h4>
                    <div class="row">
                        <!-- Select: Type de Demande -->
                        <div class="col-md-12 mb-3">
                            <label for="type_demande_id" class="form-label fw-bold">Quel service souhaitez-vous ?</label>
                            <select id="type_demande_id" name="type_demande_id" class="form-select" data-placeholder="Sélectionnez un service..."></select>
                        </div>

                        <!-- Placeholder pour le select PEF (injecté par JS) -->
                        <div id="pef-select-container" class="col-md-6 mb-3" style="display: none;"></div>

                        <!-- Placeholder pour le select Type de Paiement (injecté par JS) -->
                        <div id="type-paiement-select-container" class="col-md-6 mb-3" style="display: none;"></div>
                    </div>

                    <!-- Résumé dynamique -->
                    <div id="summary-card" style="display: none;">
                        <div id="summary-content">
                            <!-- Le contenu du résumé sera injecté ici par JS -->
                        </div>
                    </div>
                </div>

                <!-- Étape 2: Confirmation des informations -->
                <div class="step-content" data-step="2">
                    <h4 class="card-title mb-4">Étape 2: Confirmez vos informations</h4>
                    <form id="client-info-form">
                        <div class="alert alert-info" role="alert">
                            Veuillez vérifier vos informations avant de générer l'avis de paiement.
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="client_nom" class="form-label fw-bold">Nom</label>
                                <input type="text" id="client_nom" name="client_nom" class="form-control" required readonly>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="client_prenom" class="form-label fw-bold">Prénom(s)</label>
                                <input type="text" id="client_prenom" name="client_prenom" class="form-control" readonly>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="telephone" class="form-label fw-bold">
                                    numéro TresorPay
                                    <a href="https://pay.tresor.gouv.ci/" target="_blank">
                                        <img src="https://pay.tresor.gouv.ci/r/assets/images/logo_horizontal_tresorpay.png" alt="TresorPay Logo" style="height: 20px; vertical-align: middle;">
                                    </a>
                                </label>
                                <input type="tel" id="telephone" name="telephone" class="form-control" placeholder="Ex: 0707070707" required>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Étape 3: Résultat du paiement -->
                <!-- Ce contenu est géré par la section #result-container ci-dessous -->

                <!-- Boutons de navigation -->
                <div class="mt-5 d-flex justify-content-between align-items-center">
                    <button id="btn-prev" class="btn btn-secondary" style="display: none;">Précédent</button>
                    <div class="ms-auto">
                        <button id="btn-reset" class="btn btn-outline-danger me-2">Réinitialiser</button>
                        <button id="btn-next" class="btn btn-primary" disabled>Suivant</button>
                        <button id="btn-submit" class="btn btn-success" style="display: none;">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true" style="display: none;"></span>
                            Confirmer et Générer l'Avis
                        </button>
                    </div>
                </div>
            </div>

            <!-- Zone de résultat (après soumission) -->
            <div id="result-container" class="mt-4" style="display: none;"></div>

        </div>
    </div>
</div>

{# Ajout de la librairie JavaScript TomSelect AVANT notre script principal #}
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
<script src="{{ asset('assets/js/paiement/main.js') }}"></script>
{% endblock %}

