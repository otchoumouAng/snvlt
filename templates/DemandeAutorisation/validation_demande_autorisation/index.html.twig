{% extends 'template_base.html.twig' %}

{% block Title %}
    {% trans %}SNVLT{% endtrans %} - {% trans %}Validation des Demandes{% endtrans %}
{% endblock %}

{% block menu %}
    {% include 'base/menu.html.twig' %}
{% endblock %}

{% block page_content %}
<script src="https://unpkg.com/@phosphor-icons/web"></script>


<style>
    /* --- FONDATIONS & DESIGN SYSTEM --- */
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
    :root {
        --font-family-base: 'Inter', sans-serif;
        --color-primary: #006400;
        --color-primary-light: #e6f4e6;
        --color-primary-lighter: #f2f9f2;
        --color-primary-dark: #004d00;
        --color-text-primary: #212529;
        --color-text-secondary: #6c757d;
        --color-background: #f8f9fa;
        --color-surface: #ffffff;
        --color-border: #dee2e6;
        
        --status-approved-bg: #d1e7dd;
        --status-approved-text: #0f5132;
        --status-pending-bg: #fff3cd;
        --status-pending-text: #664d03;
        --status-rejected-bg: #f8d7da;
        --status-rejected-text: #842029;

        --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
        --shadow-md: 0 4px 6px -1px rgba(0,100,0,0.07), 0 2px 4px -2px rgba(0,100,0,0.07);
        --border-radius: 12px;
    }

    body {
        background-color: var(--color-background);
        font-family: var(--font-family-base);
        color: var(--color-text-primary);
    }

    /* --- ONGLET DE NAVIGATION AMÉLIORÉ (NAV TABS) --- */
    .nav-tabs {
        border-bottom: none;
        background-color: var(--color-background);
        padding: 0.5rem;
        border-radius: var(--border-radius);
        display: inline-flex;
        gap: 0.5rem;
        flex-shrink: 0; /* Empêche les onglets de se réduire */
    }

    .nav-tabs .nav-item { margin: 0; }

    .nav-tabs .nav-link {
        border: none !important;
        border-radius: 8px !important;
        font-weight: 600;
        color: var(--color-text-secondary);
        padding: 0.75rem 1.5rem;
        transition: all 0.3s ease-in-out;
        background-color: transparent;
    }

    .nav-tabs .nav-link:not(.active):hover {
        background-color: var(--color-primary-light);
        color: var(--color-primary-dark);
    }

    .nav-tabs .nav-link.active {
        background-color: var(--color-primary) !important;
        color: white !important;
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }
    
    /* --- CARTE PRINCIPALE (PRO-CARD) AVEC HAUTEUR FIXE --- */
    .pro-card {
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-md);
        
        /* ✅ CORRECTION (Hauteur) */
        /* On force la carte à être un conteneur flex sur toute sa hauteur */
        display: flex;
        flex-direction: column;
        /* Hauteur fixe et responsive. Vous pouvez ajuster cette valeur (ex: 70vh, 85vh) */
        height: 75vh; 
    }

    .pro-card-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0; /* Empêche l'en-tête de se réduire */
    }
    
    .pro-card .card-body {
        flex-grow: 1; /* Le corps de la carte prend toute la place verticale restante */
        overflow-y: auto; /* Affiche une barre de défilement verticale si nécessaire */
        min-height: 0; /* Astuce Flexbox cruciale pour que l'overflow fonctionne */
        padding: 1rem;
        
        /* On transforme aussi le corps en conteneur flex pour mieux contrôler le contenu */
        display: flex;
        flex-direction: column;
    }

    .pro-card-title {
        font-weight: 600;
        font-size: 1.1rem;
        color: var(--color-text-primary);
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .pro-card-title i {
        font-size: 1.5rem;
        color: var(--color-primary);
    }

    /* --- GESTION DU CONTENU AVEC ONGLET --- */
    .tab-content {
        flex-grow: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .tab-pane {
        flex-grow: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    
    /* ✅ CORRECTION (Le "Train") */
    /* C'est ce conteneur qui gère maintenant les deux barres de défilement */
    .table-container {
       flex-grow: 1;
       overflow: auto; /* Gère le défilement vertical ET horizontal */
       min-height: 0;
    }

    /* On nettoie les anciens styles qui ne sont plus nécessaires */
    .custumiz { height: auto; overflow: visible; }

    /* --- DATATABLE AMÉLIORÉE --- */
    .dataTables_wrapper { padding: 0 !important; }

    table.dataTable {
        border-collapse: separate !important;
        border-spacing: 0 8px !important;
        margin-top: -8px !important;
    }

    table.dataTable thead th {
        border-bottom: 1px solid var(--color-border) !important;
        color: var(--color-text-secondary);
        font-weight: 500;
        text-transform: uppercase;
        font-size: 0.75rem;
        padding: 0.75rem 1rem !important;
    }

    table.dataTable tbody tr { transition: all 0.3s ease; }

    table.dataTable tbody td {
        background-color: var(--color-surface);
        padding: 1rem !important;
        border: none !important;
        border-bottom: 1px solid var(--color-background) !important;
        color: var(--color-text-primary);
        font-weight: 500;
    }
    table.dataTable tbody td:first-child {
        border-top-left-radius: 8px;
        border-bottom-left-radius: 8px;
    }
    table.dataTable tbody td:last-child {
        border-top-right-radius: 8px;
        border-bottom-right-radius: 8px;
    }
    
    table.dataTable tbody tr:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
        cursor: pointer;
    }
    
    table.dataTable tbody tr.selected td {
        background-color: var(--color-primary-lighter) !important;
        box-shadow: 0 0 0 2px var(--color-primary);
    }

    /* --- STYLES DES STATUTS --- */
    #demandesTable .status-badge, #demandesTraiteesTable .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.8rem;
    }
    #demandesTable .status-approved, #demandesTraiteesTable .status-approved { 
        background-color: var(--status-approved-bg);
        color: var(--status-approved-text);
    }
    #demandesTable .status-pending, #demandesTraiteesTable .status-pending { 
        background-color: var(--status-pending-bg);
        color: var(--status-pending-text);
    }
    #demandesTable .status-rejected, #demandesTraiteesTable .status-rejected { 
        background-color: var(--status-rejected-bg);
        color: var(--status-rejected-text);
    }

    /* --- PANNEAU DE DROITE (DÉTAILS) --- */
    .details-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        text-align: center;
        color: var(--color-text-secondary);
        border: 2px dashed var(--color-border);
        border-radius: var(--border-radius);
        background-color: #fcfcfc;
    }
    .details-placeholder i { font-size: 3rem; color: #ced4da; }

    #details-content { transition: opacity 0.4s ease; }
    #details-content.visible { opacity: 1; }

    .document-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    .document-list .list-group-item {
        display: flex;
        align-items: center;
        padding: 1rem;
        background-color: var(--color-background);
        border-radius: 8px;
        border: 1px solid transparent;
        transition: all 0.3s ease;
    }
    .document-list .list-group-item:hover {
        background-color: #f0f0f0;
        border-color: var(--color-border);
        transform: translateX(5px);
    }

    /* Styles pour les badges de statut dans le panneau de détails */
    .badge {
        font-size: 0.75rem;
        padding: 0.3rem 0.6rem;
        border-radius: 50px;
        font-weight: 600;
    }
    .badge.bg-info {
        background-color: var(--color-primary-light) !important;
        color: var(--color-primary) !important;
    }
    .list-group-item.active {
        background-color: var(--color-primary-light) !important;
        color: var(--color-primary) !important;
        border-left: 4px solid var(--color-primary) !important;
    }

    /* --- STYLES SPÉCIFIQUES POUR LA VALIDATION --- */
    .refuse-doc-btn { display: none; }
    .list-group-item:hover .refuse-doc-btn { display: inline-block; }
    .list-group-item.refused {
        background-color: #f8d7da !important;
        border-color: #f5c2c7 !important;
    }
    .doc-badge {
        display: inline-block;
        padding: 0.3rem 0.7rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 50px;
        margin-right: 0.5rem;
        letter-spacing: 0.5px;
    }
    .doc-status-loaded { color: var(--status-approved-text); background-color: var(--status-approved-bg); }
    .doc-status-pending { color: var(--status-pending-text); background-color: var(--status-pending-bg); }
    .doc-status-rejected { color: var(--status-rejected-text); background-color: var(--status-rejected-bg); }
    .doc-status-default { color: var(--color-text-secondary); background-color: var(--color-border); }

    #validation-actions {
        margin-top: auto; /* Pousse les actions en bas */
        padding-top: 1.5rem;
        border-top: 1px solid var(--color-border);
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card pro-card wow-fadeIn">
                <div class="pro-card-header">
                    <div class="pro-card-title">
                        <i class="ph-fill ph-files"></i>
                        <span>Demandes d'Autorisations à Valider</span>
                    </div>
                </div>
                <div class="card-body p-0 d-flex flex-column">
                    <ul class="nav nav-tabs" id="demandeTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="en-cours-tab" data-bs-toggle="tab" data-bs-target="#en-cours" type="button" role="tab" aria-controls="en-cours" aria-selected="true">Demandes en cours</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="traitees-tab" data-bs-toggle="tab" data-bs-target="#traitees" type="button" role="tab" aria-controls="traitees" aria-selected="false">Demandes traitées</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="demandeTabsContent">
                        <div class="tab-pane fade show active" id="en-cours" role="tabpanel" aria-labelledby="en-cours-tab">
                            <div class="table-container">
                                <table id="demandesTable" class="table table-hover" style="width:100%">
                                   <thead>
                                        <tr>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="traitees" role="tabpanel" aria-labelledby="traitees-tab">
                            <div class="table-container">
                                <table id="demandesTraiteesTable" class="table table-hover" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>ID</th>
                                            <th>Type de Demande</th>
                                            <th>Société</th>
                                            <th>Statut Demande</th>
                                            <th class="none">Date Traitement</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>

        <div class="col-lg-5">
            <div class="card pro-card wow-slideIn">
                <div class="pro-card-header">
                      <div class="pro-card-title">
                        <i class="ph-fill ph-folder-open"></i>
                        <span id="details-title-text">Détails de la Demande</span>
                    </div>
                 </div>
                <div class="card-body" id="details-panel">
                    <div id="details-placeholder" class="details-placeholder">
                        <i class="ph-light ph-file-search"></i>
                         <p class="mt-3">Sélectionnez une demande pour voir ses détails.</p>
                    </div>
                    <div id="details-content" class="details-content">
                        </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="rejectedDocsModal" tabindex="-1" aria-labelledby="rejectedDocsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rejectedDocsModalLabel"><i class="ph-fill ph-file-x"></i> Documents Rejetés</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>La liste ci-dessous présente les documents qui ont été rejetés pour cette demande.</p>
                <div class="table-responsive">
                     <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Type de Document</th>
                                <th>Nom du Fichier</th>
                                <th>Action</th>
                            </tr>
                         </thead>
                        <tbody id="rejectedDocsTableBody">
                            </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
         </div>
    </div>
</div>

