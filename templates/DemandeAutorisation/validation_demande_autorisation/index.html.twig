<script>
$(document).ready(function() {
    // Initialize the module
    const validationDemandeApp = new ValidationDemandeApp();
    validationDemandeApp.init();
    
    // Ajouter un effet de pulse à la sélection
    $(document).on('click', '#demandesTable tbody tr', function() {
        $(this).addClass('wow-pulse');
        setTimeout(() => {
            $(this).removeClass('wow-pulse');
        }, 500);
    });
});
</script>

{% endblock %}