<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport de dépôt de dossier</title>
    <style>
        /* Styles généraux */
        body { 
            font-family: sans-serif; 
            font-size: 15px;
        }
        .content { 
            margin-top: 22px; 
        }
        
        /* Styles pour le tableau principal (pièces jointes) */
        .main-table { 
            width: 100%; 
            border-collapse: collapse; 
        }
        .main-table th, .main-table td { 
            border: 1px solid #ddd; 
            padding: 8px; 
        }
        .main-table th { 
            background-color: #f2f2f2; 
        }

        /* Styles pour la table de l'en-tête */
        .header-table {
            width: 100%;
            border: none; /* Pas de bordures pour la table de l'en-tête */
            margin-bottom: 30px;
        }
        .header-table td {
            border: none; /* Pas de bordures pour les cellules */
            vertical-align: middle; /* Alignement vertical au centre */
            padding: 0;
        }
        .header-table .logo-cell {
            width: 20%; /* On donne une largeur aux cellules des logos */
        }
        .header-table .logo-cell.left {
            text-align: left;
        }
        .header-table .logo-cell.right {
            text-align: right;
        }
        .header-table .title-cell {
            width: 60%;
            text-align: center;
        }
        .header-table img {
            max-width: 90px; /* Taille des logos */
            height: auto;
        }
        .header-table h1 {
             margin: 0;
             font-size: 1.7em; /* Taille du titre principal */
        }
         .header-table p {
             margin: 5px 0 0;
             font-size: 1.3em; /* Taille du sous-titre */
        }
    </style>
</head>
<body>

    <table class="header-table">
        <tr>
            <td class="logo-cell left">
                <img src="data:image/png;base64,{{ logo_eaux_forets_base64 }}" alt="Logo Eaux et Forêts">
            </td>

            <td class="title-cell">
                <h1>Rapport de dépôt de dossier pour</h1>
                <p>{{ demande.typeDemande.designation }}</p>
            </td>

            <td class="logo-cell right">
                <img src="data:image/png;base64,{{ logo_snvlt_base64 }}" alt="Logo SNVLT">
            </td>
        </tr>
    </table>

    <div class="content">
        <p><strong>Code Suivi:</strong> {{ demande.codeSuivie }}</p>
        <p><strong>Demandeur:</strong> {{ demande.operateur.nomUtilisateur }} {{ demande.operateur.prenomsUtilisateur }}</p>
        <p><strong>Société:</strong> {{ demande.operateur.codeexploitant ? demande.operateur.codeexploitant.raisonSocialeExploitant : 'N/A' }}</p>
        <p><strong>Date de soumission:</strong> {{ demande.createdAt|date('d/m/Y H:i') }}</p>

        <hr>

        <h3>Détails de la demande</h3>
        <p><strong>Type de Demande:</strong> {{ demande.typeDemande.designation }}</p>

        {% if demande.numeroPef %}
            <p><strong>Numéro PEF:</strong> {{ demande.numeroPef }}</p>
        {% endif %}

        {% if demande.produit %}
             <p><strong>Produit:</strong> {{ demande.produit }}</p>
        {% endif %}

        <p><strong>Description:</strong> {{ demande.description|nl2br }}</p>

        <hr>

        <h3>Pièces à fournir</h3>
        <table class="main-table">
            <thead>
                <tr>
                    <th>Pièces</th>
                    <th>Statuts</th>
                </tr>
            </thead>
            <tbody>
                {% for doc in documents %}
                    <tr>
                        <td>{{ doc.nom }}</td>
                        <td>{{ doc.fourni }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2">Aucun document requis pour cette demande.</td>
                    </tr>
                {% endfor %}
            </tbody>
         </table>
    </div>

</body>
</html>