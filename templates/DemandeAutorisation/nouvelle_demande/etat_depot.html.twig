<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Rapport de dépôt de dosier</title>
    <style>
        /* Add some basic styling for the PDF */
        body { font-family: sans-serif; }
        .header { text-align: center; margin-bottom: 20px; }
        .content { margin-top: 20px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; }
        th { background-color: #f2f2f2; }

        [cite_start]body { font-family: sans-serif; [cite: 1, 2] }
        [cite_start].header { text-align: center; margin-bottom: 20px; [cite: 3] }
        [cite_start].content { margin-top: 20px; [cite: 4] }
        [cite_start]table { width: 100%; border-collapse: collapse; [cite: 5] }
        [cite_start]th, td { border: 1px solid #ddd; padding: 8px; [cite: 6] }
        [cite_start]th { background-color: #f2f2f2; [cite: 7] }

        .header-content {
            display: flex;
            justify-content: space-between; 
            align-items: center;
            width: 100%;
        }
        .logo img {
            max-width: 100px; 
            height: auto;
        }
        .title-container {
            flex-grow: 1; 
            padding: 0 20px; 
        }
        .title-container h1 {
            margin: 0;
            font-size: 1.5em; 
        }
        .title-container p {
            margin: 5px 0 0;
            font-size: 1.2em; 
        }

    </style>
</head>
<body>
    <div class="header">
        <div class="header-content">
            <div class="logo">
                <img src="{{asset('assets/images/logo_eaux_forets_etat_depot.png')}}" alt="Logo Eaux et Forêts">
            </div>
            <div class="title-container">
                <h1>Rapport de dépôt de dossier pour</h1>
                <p>{{ demande.typeDemande.designation }}</p>
            </div>
            <div class="logo">
                <img src="{{asset('assets/images/SNVLT.png')}}" alt="Logo SNVLT">
            </div>
        </div>
    </div>

    <div class="content">
        <p><strong>Code Suivi:</strong> {{ demande.codeSuivie }}</p>
        <p><strong>Demandeur:</strong> {{ demande.operateur.nomUtilisateur }} {{ demande.operateur.prenomsUtilisateur }}</p>
        <p><strong>Société:</strong> {{ demande.operateur.codeexploitant ? demande.operateur.codeexploitant.raisonSocialeExploitant : 'N/A' }}</p>
        <p><strong>Date de soumission:</strong> {{ demande.createdAt|date('d/m/Y H:i') }}</p>

        <hr>

        <h3>Détails de la demande</h3>
        <p><strong>Type de Demande:</strong> {{ demande.typeDemande.designation }}</p>

        {% if demande.numeroPef %}
            <p><strong>Numéro PEF:</strong> {{ demande.numeroPef }}</p>
        {% endif %}

        {% if demande.produit %}
            <p><strong>Produit:</strong> {{ demande.produit }}</p>
        {% endif %}

        <p><strong>Description:</strong> {{ demande.description|nl2br }}</p>

        <hr>

        <h3>Pièces jointes</h3>
        <table>
            <thead>
                <tr>
                    <th>Fichier</th>
                    <th>Statut</th>
                </tr>
            </thead>
            <tbody>
                {% for doc in documents %}
                    <tr>
                        <td>{{ doc.nom }}</td>
                        <td>{{ doc.fourni }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="2">Aucun document requis pour cette demande.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>
</html>
